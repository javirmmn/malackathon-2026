# Copiar a .env (que NO se sube al repo) y rellenar.
# Las credenciales de MALACK se comparten por un canal seguro, nunca por el repo ni el chat del equipo.

ORACLE_USER=MALACK
ORACLE_PASSWORD=

# Alias del tnsnames.ora del wallet: malackathon_low | malackathon_medium | malackathon_high | malackathon_tp | malackathon_tpurgent
# Para cargas y consultas normales basta con _low o _tp.
ORACLE_DSN=malackathon_low

# Carpeta donde se ha descomprimido el wallet (Database connection -> Download wallet).
# Mejor fuera del repo, p. ej. C:\Users\<tu_usuario>\oracle\Wallet_malackathon
ORACLE_WALLET_DIR=

# Contraseña que se puso al descargar el wallet (necesaria en modo thin de python-oracledb).
ORACLE_WALLET_PASSWORD=
